{
  "custom/voxtype": {
    "exec": "voxtype status --follow --format json",
    "return-type": "json",
    "on-click": "voxtype record toggle",
    "on-click-right": "voxtype record cancel",
    "format": "{icon}",
    "format-icons": {
      "idle": "󰗋",
      "recording": "",
      "transcribing": "󰔮",
      "stopped": "󰻔"
    },
    "tooltip": true
  }
}
