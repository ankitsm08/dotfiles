{
  "backlight": {
    "scroll-step": 2,
    "format": "{percent}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ],
    "on-click": "brightnessctl set 10%",
    "on-click-right": "brightnessctl set 90%",
    "on-click-middle": "foot --app-id=TUI.float -e jolt"
  }
}
