{
  "memory#small": {
    "interval": 5,
    "format": "{percentage}% ",
    "format-alt": "{swapPercentage}% ",
    "tooltip": true,
    "tooltip-format": "RAM   : {used:0.1f}/{total:0.1f}G ({percentage}%)\nAvail : {avail:0.1f}G\nSwap  : {swapUsed:0.1f}/{swapTotal:0.1f}G ({swapPercentage}%)",
    "on-click-middle": "foot --app-id=TUI.float -e btm"
  },
  "memory#big": {
    "interval": 5,
    "format": "{used:0.1f}G/{total:0.1f}G ",
    "format-alt": "{percentage}% {swapPercentage}% ",
    "tooltip": true,
    "tooltip-format": "RAM   : {used:0.1f}/{total:0.1f}G ({percentage}%)\nAvail : {avail:0.1f}G\nSwap  : {swapUsed:0.1f}/{swapTotal:0.1f}G ({swapPercentage}%)",
    "on-click-middle": "foot --app-id=TUI.float -e btm"
  }
}
