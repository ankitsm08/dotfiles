// This configuration is merged with the default vicinae configuration file, which you can obtain by running the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
//
// You can make manual edits to this file, however you should keep in mind that this file may be written to by vicinae when a configuration change is made through the GUI.
// When that happens, any custom comments or formatting will be lost.
//
// If you want to maintain a configuration file with your own comments and formatting, you should create a separate file and add it to the 'imports' array.
//
// Learn more about configuration at https://docs.vicinae.com/config

{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": true,
   "pop_to_root_on_close": true,
   "global_shortcuts": {
      "toggle": ""
   },
   "font": {
      "normal": {
         "family": "Inter Variable",
         "size": 12
      }
   },
   "theme": {
      "dark": {
         "name": "catppuccin-mocha",
         "icon_theme": "Catppuccin Mocha Dark"
      }
   },
   "telemetry": {
      "system_info": false
   },
   "launcher_window": {
      "opacity": 0.85,
      "size": {
         "width": 1280,
         "height": 720
      },
      "compact_mode": {
         "enabled": true
      },
      "material": "none"
   },
   "favorites": [],
   "providers": {
      "@CT-7567/store.raycast.simple-dictionary": {
         "entrypoints": {
            "search": {
               "alias": "ds",
               "preferences": {
                  "default_language": "en"
               }
            }
         }
      },
      "@DrChai/store.raycast.dictionary": {
         "entrypoints": {
            "fromCmd": {
               "alias": "d"
            }
         }
      },
      "@aurelleb/store.vicinae.dashboard-icons": {
         "entrypoints": {
            "search-icons": {
               "alias": "di",
               "preferences": {
                  "columns": "6",
                  "copy-format": "svg"
               }
            }
         }
      },
      "@dagimg-dot/store.vicinae.player-pilot": {
         "entrypoints": {
            "player-pilot": {
               "alias": "p"
            }
         }
      },
      "@fbosch/store.vicinae.nerdfont-search": {
         "entrypoints": {
            "nerdfonts-search": {
               "alias": "snf"
            }
         }
      },
      "@josephschmitt/store.raycast.gif-search": {
         "entrypoints": {
            "search": {
               "alias": "gif"
            }
         }
      },
      "@knoopx/store.vicinae.firefox": {
         "preferences": {
            "profile_dir": "/.config/zen"
         },
         "entrypoints": {
            "bookmarks": {
               "alias": "b"
            }
         }
      },
      "@luleyleo/store.vicinae.wiktionary": {
         "preferences": {
            "resultLanguages": "en",
            "source": "empty"
         },
         "entrypoints": {
            "define": {
               "alias": "dw",
               "enabled": true
            }
         }
      },
      "@marcjulian/store.raycast.obsidian": {
         "entrypoints": {
            "searchNoteCommand": {
               "alias": "ob"
            }
         }
      },
      "@pernielsentikaer/store.raycast.urban-dictionary": {
         "entrypoints": {
            "index": {
               "alias": "du"
            }
         }
      },
      "@sovereign/store.vicinae.awww-switcher": {
         "preferences": {
            "wallpaperPath": "~/.config/wallpapers/",
            "colorGenTool": "none",
            "gridRows": "3",
            "postProduction": "no",
            "showImageDetails": true,
            "toggleVicinaeSetting": false,
            "transitionDuration": "3",
            "transitionFPS": "60",
            "transitionStep": "90",
            "transitionType": "random"
         },
         "entrypoints": {
            "wpgrid": {
               "alias": "aw"
            },
            "wprandom": {
               "alias": "rw"
            }
         }
      },
      "applications": {
         "entrypoints": {
            "assistant": {
               "enabled": false
            },
            "avahi-discover": {
               "enabled": false
            },
            "bssh": {
               "enabled": false
            },
            "bvnc": {
               "enabled": false
            },
            "cmake-gui": {
               "enabled": false
            },
            "designer": {
               "enabled": false
            },
            "electron36": {
               "enabled": false
            },
            "electron37": {
               "enabled": false
            },
            "htop": {
               "enabled": false
            },
            "linguist": {
               "enabled": false
            },
            "qdbusviewer": {
               "enabled": false
            },
            "qv4l2": {
               "enabled": false
            },
            "qvidcap": {
               "enabled": false
            },
            "rofi": {
               "enabled": false
            },
            "rofi-theme-selector": {
               "enabled": false
            },
            "vim": {
               "enabled": false
            },
            "xgps": {
               "enabled": false
            },
            "xgpsspeed": {
               "enabled": false
            }
         }
      },
      "browser-extension": {
         "entrypoints": {
            "browse-tabs": {
               "alias": "b"
            }
         }
      },
      "calculator": {
         "enabled": true,
         "preferences": {
            "backend": "qalculate"
         }
      },
      "clipboard": {
         "entrypoints": {
            "history": {
               "alias": "v"
            }
         }
      },
      "core": {
         "entrypoints": {
            "search-emojis": {
               "alias": "e",
               "preferences": {
                  "defaultAction": "paste",
                  "skinTone": "default"
               }
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "files": {
         "enabled": false,
         "preferences": {
            "autoIndexing": false,
            "excludedPaths": "*/node_modules;*/.venv;",
            "paths": "/home/ank/dotfiles;/home/ank/dev;/home/ank/lab;/home/ank/dl;/home/ank/docs;",
            "watcherPaths": "",
            "excludedIndexingPaths": [],
            "indexingPaths": [
               "/home/ank"
            ]
         },
         "entrypoints": {
            "search": {
               "enabled": false
            }
         }
      },
      "raycast-compat": {
         "entrypoints": {
            "store": {
               "preferences": {
                  "alwaysShowIntro": true
               }
            }
         }
      },
      "system": {
         "entrypoints": {
            "run": {
               "alias": ">",
               "preferences": {
                  "default-action": "run"
               }
            }
         }
      },
      "wm": {
         "entrypoints": {
            "switch-windows": {
               "alias": "w"
            }
         }
      }
   }
}