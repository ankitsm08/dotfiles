#!/bin/bash

# --- Colors and Formatting ---
GREEN='\033[1;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# --- Dependency Check ---
for cmd in gs qpdf pdfinfo numfmt stat; do
  if ! command -v $cmd &> /dev/null; then
    echo -e "${RED}Error: Required command '$cmd' not found.${NC}"
    echo -e "Please install missing packages: sudo pacman -S ghostscript qpdf poppler coreutils"
    exit 1
  fi
done

# --- Input Validation ---
input="$1"

if [ -z "$input" ] || [ ! -f "$input" ]; then
  echo -e "${RED}Usage: ${BOLD}pdfopt <input_file.pdf>${NC}"
  exit 1
fi

# --- File Variables ---
# Extracts filename without extension and appends suffixes
base="${input%.*}"
tmp_file="${base}-tmp.pdf"
output="${base}-opt.pdf"

echo -e "\n${BLUE}${BOLD}=== PDF Optimization Pipeline ===${NC}"
echo -e "Input File:  ${YELLOW}$input${NC}"
echo -e "Output File: ${GREEN}$output${NC}\n"

# --- Get Total Pages ---
total_pages=$(pdfinfo "$input" 2>/dev/null | awk '/^Pages:/ {print $2}')
if [ -z "$total_pages" ]; then
  echo -e "${RED}Error: Could not read page count. Is it a valid PDF?${NC}"
  exit 1
fi

echo -e "${BOLD}[1/2] Compressing with Ghostscript (/printer quality)...${NC}"

# --- Run Ghostscript with Visual Progress Bar ---
# Note: -dQUIET is deliberately omitted so awk can catch "Page N" outputs
gs -sDEVICE=pdfwrite \
  -dCompatibilityLevel=1.4 \
  -dPDFSETTINGS=/printer \
  -dNOPAUSE \
  -dBATCH \
  -sOutputFile="$tmp_file" \
"$input" 2>&1 | awk -v total="$total_pages" '
    BEGIN {
        GREEN = "\033[1;32m"
        BLUE = "\033[1;34m"
        NC = "\033[0m"
    }
    /Page [0-9]+/ {
        page = $2
        percent = int((page / total) * 100)

        # 40-character wide progress bar
        bar_width = 40
        filled = int((percent / 100) * bar_width)
        empty = bar_width - filled

        bar_filled = ""
        for (i=0; i<filled; i++) bar_filled = bar_filled "█"

        bar_empty = ""
        for (i=0; i<empty; i++) bar_empty = bar_empty "▒"

        # Print carriage return (\r) to overwrite the same line
        printf "\r  ↳ Progress: [%s%s%s%s] %3d%% (%d/%d pages)", BLUE, bar_filled, NC, bar_empty, percent, page, total
        fflush()
    }
    END { printf "\n" }
'

# Check if GS generated the temp file successfully
if [ ! -f "$tmp_file" ]; then
  echo -e "\n${RED}Error: Ghostscript failed to process the PDF.${NC}"
  exit 1
fi

echo -e "\n${BOLD}[2/2] Rebuilding and Linearizing with QPDF...${NC}"

# --- Run QPDF (Structural Optimization) ---
# --linearize: Fast web view (instant loading)
# --object-streams=generate: Compresses internal cross-reference tables
# --recompress-flate: Forces maximum compression on text/vector streams
qpdf --linearize \
  --object-streams=generate \
  --recompress-flate \
  "$tmp_file" "$output"

# Check if QPDF succeeded
if [ $? -eq 0 ] && [ -f "$output" ]; then
  echo -e "  ↳ ${GREEN}Optimization Complete!${NC}\n"
else
  echo -e "  ↳ ${RED}QPDF optimization failed.${NC}\n"
  rm -f "$tmp_file"
  exit 1
fi

# Cleanup
rm -f "$tmp_file"

# --- Calculate and Display Final Results ---
orig_size=$(stat -c%s "$input")
new_size=$(stat -c%s "$output")

# Convert bytes to human-readable format (e.g., MB, KB)
orig_hr=$(numfmt --to=iec-i --suffix=B "$orig_size")
new_hr=$(numfmt --to=iec-i --suffix=B "$new_size")

if [ "$orig_size" -gt 0 ]; then
  reduction=$(( 100 - (new_size * 100 / orig_size) ))
else
  reduction=0
fi

echo -e "${BLUE}${BOLD}=== Final Results ===${NC}"
echo -e "Original Size: ${RED}$orig_hr${NC}"
echo -e "Optimized Size: ${GREEN}$new_hr${NC}"
echo -e "Space Saved:   ${YELLOW}${reduction}%${NC}\n"
echo -e "✨ ${GREEN}${BOLD}File is fully linearized, search-indexed, and ready!${NC}\n"
